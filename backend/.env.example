# GCP
GCP_PROJECT_ID=followthrough-hack
GCP_REGION=us-central1

# Gemini / Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=True
GEMINI_MODEL=gemini-3.5-flash

# Firestore (uses GCP_PROJECT_ID above, no separate key needed with ADC)

# Pub/Sub topics
PUBSUB_TOPIC_MEETING_PROCESSED=meeting-processed
PUBSUB_TOPIC_TASK_CREATED=task-created
PUBSUB_TOPIC_TASK_BLOCKED=task-blocked
PUBSUB_TOPIC_TASK_VERIFIED=task-verified

# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=your-org/your-demo-repo

# Gmail (for escalation email - use an app password or OAuth, TBD)
GMAIL_SENDER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
ESCALATION_RECIPIENT=teammate@example.com
