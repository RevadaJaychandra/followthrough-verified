# Copy to .env and fill in. .env is gitignored — never commit real values.
# Run `python config.py` afterwards; it reports exactly what is still missing
# or still a placeholder, with no network calls.

# ---------- offline mode ----------
# true  = every external call (Gemini, Firestore, Pub/Sub, GitHub, Gmail) uses
#         an in-memory stub. No credentials needed, nothing leaves the process.
# false = the real thing. This is what the submission demo runs.
OFFLINE_MODE=true

# ---------- GCP ----------
GCP_PROJECT_ID=followthrough-hack
GCP_REGION=us-central1

# ---------- Gemini / Vertex AI ----------
GOOGLE_GENAI_USE_VERTEXAI=True
# Verified against Vertex on 2026-08-30. Newer alternatives: gemini-3.7-flash,
# gemini-3.6-flash. The server runs a preflight call at startup and logs a
# clear warning (with the fix) if this id is no longer valid.
GEMINI_MODEL=gemini-3.5-flash
# Optional: use the AI Studio API key path instead of Vertex + ADC. Handy for
# testing extraction alone before GCP IAM is fully wired up.
# GEMINI_API_KEY=

# ---------- Firestore ----------
# Uses GCP_PROJECT_ID above via application-default credentials. No key needed.

# ---------- Pub/Sub topics ----------
PUBSUB_TOPIC_MEETING_PROCESSED=meeting-processed
PUBSUB_TOPIC_TASK_CREATED=task-created
PUBSUB_TOPIC_TASK_BLOCKED=task-blocked
PUBSUB_TOPIC_TASK_VERIFIED=task-verified

# ---------- GitHub ----------
# Classic personal access token with 'repo' scope: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=your-org/your-demo-repo
# Optional: map transcript speaker names to GitHub usernames so issues get
# assigned. Format: Name=username,Name=username
# An unmapped name creates an unassigned issue, which is fine; a WRONG username
# makes GitHub reject the issue creation outright.
# GITHUB_USER_MAP=Kartikeya=0kartik,Rahul=rahul-dev

# ---------- Gmail (escalation email) ----------
# App password, not your account password: https://myaccount.google.com/apppasswords
GMAIL_SENDER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
ESCALATION_RECIPIENT=teammate@example.com

# ---------- API access ----------
# Browser origins allowed to call this API, comma-separated. Add the deployed
# dashboard URL once the frontend is hosted.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
